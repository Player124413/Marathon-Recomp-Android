modules = ["python-base-3.13"]
[nix]
channel = "stable-25_05"

[agent]
expertMode = true

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Build APK"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Build .so files"

[[workflows.workflow]]
name = "Build APK"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash build-apk.sh 2>&1"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "Build .so files"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash build-android.sh 2>&1"

[workflows.workflow.metadata]
outputType = "console"
