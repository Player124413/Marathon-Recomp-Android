<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    android:installLocation="auto">

    <!-- Vulkan 1.1 (Mali-G57 supports Vulkan 1.1) -->
    <uses-feature android:name="android.hardware.vulkan.version"
        android:version="0x00401000"
        android:required="true" />
    <uses-feature android:name="android.hardware.vulkan.level"
        android:version="0"
        android:required="false" />

    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- The Android build is a touch-first landscape experience. -->
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="true" />

    <!-- Game controller support -->
    <uses-feature
        android:name="android.hardware.bluetooth"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.gamepad"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.usb.host"
        android:required="false" />

    <!-- External mouse input events -->
    <uses-feature
        android:name="android.hardware.type.pc"
        android:required="false" />

    <!-- Vibration for rumble support -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Read external storage for game data files (API 28) -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:hardwareAccelerated="true"
        android:theme="@style/AppTheme"
        android:resizeableActivity="false">

        <!-- Entry point: checks for game files, allows picking them via SAF,
             and provides access to the Settings screen. -->
        <activity
            android:name="org.libsdl.app.LauncherActivity"
            android:label="@string/app_name"
            android:exported="true"
            android:theme="@style/LauncherTheme">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Settings screen: graphics driver, touch controls, audio, system -->
        <activity
            android:name="org.libsdl.app.SettingsActivity"
            android:label="@string/settings_title"
            android:exported="false"
            android:parentActivityName="org.libsdl.app.LauncherActivity"
            android:theme="@style/SettingsTheme" />

        <!-- The actual game (SDL). Only ever started from LauncherActivity once
             game files are confirmed present — not itself a launcher activity. -->
        <activity
            android:name="org.libsdl.app.GameActivity"
            android:label="@string/app_name"
            android:exported="false"
            android:screenOrientation="sensorLandscape"
            android:keepScreenOn="true"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize"
            android:launchMode="singleTask" />
    </application>

</manifest>
