<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Game activity: full-screen, no chrome -->
    <style name="AppTheme" parent="@android:style/Theme.NoTitleBar.Fullscreen" />

    <!-- Launcher / Settings: dark Material theme -->
    <style name="LauncherTheme" parent="@android:style/Theme.Material">
        <item name="android:windowBackground">@color/bg_dark</item>
        <item name="android:colorPrimary">@color/accent_blue</item>
        <item name="android:colorPrimaryDark">@color/bg_dark</item>
        <item name="android:colorAccent">@color/accent_blue</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:statusBarColor">@color/bg_dark</item>
        <item name="android:navigationBarColor">@color/bg_dark</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
    </style>

    <style name="SettingsTheme" parent="@android:style/Theme.Material">
        <item name="android:windowBackground">@color/bg_dark</item>
        <item name="android:colorPrimary">@color/bg_card</item>
        <item name="android:colorPrimaryDark">@color/bg_dark</item>
        <item name="android:colorAccent">@color/accent_blue</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:statusBarColor">@color/bg_dark</item>
        <item name="android:navigationBarColor">@color/bg_dark</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:actionBarStyle">@style/DarkActionBar</item>
    </style>

    <style name="DarkActionBar" parent="@android:style/Widget.Material.ActionBar">
        <item name="android:background">@color/bg_card</item>
        <item name="android:titleTextStyle">@style/DarkActionBarTitle</item>
    </style>

    <style name="DarkActionBarTitle" parent="@android:style/TextAppearance.Material.Widget.ActionBar.Title">
        <item name="android:textColor">@color/text_primary</item>
    </style>

</resources>
