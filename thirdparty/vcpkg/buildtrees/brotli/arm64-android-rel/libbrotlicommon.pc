prefix=/home/runner/workspace/thirdparty/vcpkg/packages/brotli_arm64-android
exec_prefix=/home/runner/workspace/thirdparty/vcpkg/packages/brotli_arm64-android
libdir=${prefix}/lib
includedir=${prefix}/include

